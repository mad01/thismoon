{
  "filesystem": {
    "allowRead": [
      "~/code",
      "~/.worktrees",
      "~/.config/ralph/sources",
      "~/.local/state/moondb"
    ],
    "allowWrite": [
      "~/.local/state/moondb",
      "/private/tmp",
      "/private/var/folders"
    ],
    "denyRead": [
      "~",
      "~/code/**/.env",
      "~/code/**/.env.*",
      "~/code/**/*.pem",
      "~/code/**/*.key",
      "~/.worktrees/**/.env",
      "~/.worktrees/**/.env.*",
      "~/.worktrees/**/*.pem",
      "~/.worktrees/**/*.key",
      "~/.config/ralph/sources/**/.env",
      "~/.config/ralph/sources/**/.env.*",
      "~/.config/ralph/sources/**/*.pem",
      "~/.config/ralph/sources/**/*.key"
    ],
    "denyWrite": []
  },
  "network": {
    "allowLocalBinding": true,
    "allowedDomains": [],
    "deniedDomains": []
  }
}
