{
  "enableWeakerNetworkIsolation": true,
  "filesystem": {
    "allowRead": [
      "~/code/bin",
      "~/.config/present"
    ],
    "allowWrite": [
      "~/.config/present",
      "/private/tmp",
      "/private/var/folders"
    ],
    "denyRead": [
      "~"
    ],
    "denyWrite": []
  },
  "network": {
    "allowLocalBinding": true,
    "allowedDomains": [],
    "deniedDomains": []
  }
}
