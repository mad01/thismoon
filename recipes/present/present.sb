;; present MCP seatbelt profile (sandbox-exec)
;;
;; Confines the present MCP server so a poisoned dependency can't exfiltrate
;; data or read secrets. `present mcp` never serves pages — it shares the page
;; store on disk with the separate (unsandboxed) `present serve` daemon:
;;   - egress shaped, not zero: the local events port, plus outbound HTTPS
;;     and DNS so present_share can reach the shared instance; no inbound
;;   - $HOME reads default-DENIED; allow-list is the binaries dir and the
;;     page store (a secrets blocklist can never be complete — deny the lot,
;;     allow what the server needs)
;;   - writes confined to the page store + temp (the MCP writes pages/<id>/)
;;
;; present_open execs /usr/bin/open, which inherits this sandbox. `open` only
;; sends a LaunchServices mach message (allowed by the default baseline); the
;; browser itself is launched by launchd OUTSIDE the sandbox.
;;
;; Baseline is (allow default) so dyld/system frameworks just work — same
;; shape as recipes/humanizer/humanizer.sb. Spawned via
;; present-mcp-sandbox.sh, which supplies -D HOME=<home>, scrubs env, and
;; cd-s to / first (getcwd in a read-denied cwd is an EPERM).
;;
;; Tuning: denials show up via the speak recipe's sandbox-watch agent — add
;; allows only when a denial actually breaks a tool, never preemptively.
;; Triage guide: recipes/speak/CLAUDE.md → "Triaging a denial".

(version 1)
(allow default)

;; ── Network: shaped, not zero. The server speaks stdio; pages are served by
;; the separate `present serve` process, not this one. It dials out for two
;; things only:
;;   - the fire-and-forget POST to the local events service
;;     (internal/notify/events.go → 127.0.0.1:7430). Before this allow it was
;;     denied on every page create, so the MCP archived nothing to
;;     events.this; the denial is what surfaced it (sandbox-watch,
;;     2026-08-20). events has no egress of its own, so that surface is one
;;     local append-only log.
;;   - present_share, which pushes a page to the shared instance named by
;;     PRESENT_SHARED_URL over HTTPS. Seatbelt can't filter by hostname, so
;;     outbound :443 to anywhere plus DNS is the practical floor (the same
;;     shape as the consuming repo's github-mcp.sb). A plain-http shared URL
;;     stays blocked here on purpose; the Share button and `present share`
;;     run outside the sandbox and take any URL.
;; system-socket: socket creation is separate from connect. DNS may resolve
;; via libresolv (direct :53) or libinfo (mDNSResponder unix socket) depending
;; on the Go resolver path, so allow both. EVENTS_BASE_URL and the shared URL
;; can't widen this: present-mcp-sandbox.sh scrubs env with `env -i` and
;; passes only the PRESENT_* config through. ──
(deny network*)
(allow system-socket)
(allow network-outbound
  (literal "/private/var/run/mDNSResponder")
  (remote tcp "localhost:7430")
  (remote tcp "*:443")
  (remote udp "*:53")
  (remote tcp "*:53"))

;; ── Filesystem writes: page store + temp only ──
(deny file-write*)
(allow file-write* (literal "/dev/null"))   ;; shell/library redirects
(allow file-write*
  (subpath (string-append (param "HOME") "/.config/present"))
  (subpath (string-append (param "HOME") "/.local/state/present"))  ;; fresh-install page store (confdir.StateDir)
  (subpath "/private/tmp")
  (subpath "/private/var/folders"))

;; ── $HOME reads: default-DENY with allow-list ──
;; System paths (/System, /usr/lib, dyld, frameworks) stay readable via the
;; default-allow baseline — they hold no user secrets.
(deny file-read*
  (subpath (param "HOME")))
(allow file-read*
  (subpath (string-append (param "HOME") "/code/bin"))            ;; present binary
  (subpath (string-append (param "HOME") "/.config/present"))     ;; page store (legacy installs)
  (subpath (string-append (param "HOME") "/.local/state/present")))  ;; page store (fresh installs)

;; realpath()/LookPath lstat() parent components of allowed paths; subpath
;; allows don't cover parents. Metadata-only (no content reads) on the spine:
(allow file-read-metadata
  (literal (param "HOME"))
  (literal (string-append (param "HOME") "/code"))
  (literal (string-append (param "HOME") "/.config"))
  (literal (string-append (param "HOME") "/.local"))
  (literal (string-append (param "HOME") "/.local/state")))
