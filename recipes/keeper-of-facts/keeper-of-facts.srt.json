{
  "network": {
    "allowedDomains": [],
    "deniedDomains": [],
    "allowLocalBinding": true
  },
  "filesystem": {
    "denyRead": [
      "~",
      "~/code/**/.env",
      "~/code/**/.env.*",
      "~/code/**/*.pem",
      "~/code/**/*.key",
      "~/.worktrees/**/.env",
      "~/.worktrees/**/.env.*",
      "~/.worktrees/**/*.pem",
      "~/.worktrees/**/*.key"
    ],
    "allowRead": [
      "~/code",
      "~/.worktrees",
      "~/.config/ralph/sources",
      "~/.local/share/kof"
    ],
    "allowWrite": [
      "~/.local/share/kof",
      "/private/tmp",
      "/private/var/folders"
    ],
    "denyWrite": []
  }
}
