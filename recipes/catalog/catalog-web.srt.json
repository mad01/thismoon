{
  "filesystem": {
    "allowRead": [
      "~/code",
      "~/.config/catalog"
    ],
    "allowWrite": [
      "~/code/**/service-info.yaml",
      "/private/tmp",
      "/private/var/folders"
    ],
    "denyRead": [
      "~",
      "~/code/**/.env",
      "~/code/**/.env.*",
      "~/code/**/*.pem",
      "~/code/**/*.key"
    ],
    "denyWrite": []
  },
  "network": {
    "allowLocalBinding": true,
    "allowedDomains": [],
    "deniedDomains": []
  }
}
