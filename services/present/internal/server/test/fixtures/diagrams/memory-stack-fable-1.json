      "flow": true
    },
    {
      "from": "moondb",
      "to": "hint",
      "label": "uncommitted files",
      "flow": true
    },
    {
      "from": "hint",
      "to": "session",
      "label": "at SessionStart",
      "flow": true
    },
    {
      "from": "moondb",
      "to": "session",
      "label": "moondb_why"
    },
    {
      "from": "worklog",
      "to": "session",
      "label": "/worklog skill"
    },
    {
      "from": "handoff",
      "to": "session",
      "label": "reads the file"
    },
    {
      "from": "events",
      "to": "session",
      "label": "events_query"
    }
  ]
