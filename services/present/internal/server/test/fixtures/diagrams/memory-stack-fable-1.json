      "tone": "blue"
    },
    {
      "id": "agentmem",
      "label": "agent-memory",
      "text": "~/.config/agent-memory/, usually a git clone",
      "kind": "store",
      "tone": "blue"
    },
    {
      "id": "moondb",
      "label": "moondb",
      "text": "~/.local/state/moondb/",
      "kind": "store",
      "tone": "blue"
    },
    {
      "id": "worklog",
      "label": "worklog",
      "text": "~/code/worklog/",
      "kind": "store",
      "tone": "blue"
    },
    {
      "id": "handoff",
      "label": "handoff",
      "text": "~/.handoff/",
      "kind": "store",
      "tone": "blue"
    },
    {
      "id": "events",
      "label": "events",
      "text": "~/.local/share/events/",
      "kind": "store",
      "tone": "blue"
    },
    {
      "id": "hint",
      "label": "belt hint session-start",
      "text": "prints each hint under a belt[<name>]: prefix",
