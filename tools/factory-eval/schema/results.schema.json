{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mad01/thismoon/tools/factory-eval/schema/results.schema.json",
  "title": "factory-eval results",
  "description": "One batch of the MAD-402 eval: every run of both arms with its scored cases, then the per-arm means and the pass decision per tier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dry_run", "started_at", "finished_at", "commit", "cases_file", "cases_digest",
    "sign_off", "claude_version", "prereqs", "settings_permissions", "runs", "summary"],
  "properties": {
    "schema": {"const": "factory-eval/results/v2"},
    "dry_run": {"type": "boolean", "description": "true when stand-ins replaced every model call"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "the pinned commit every run cloned"},
    "cases_file": {"type": "string"},
    "cases_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the cases file with its sign_off values blanked; a signed-off file holds the same value in sign_off.digest"},
    "sign_off": {
      "type": "object", "additionalProperties": false, "required": ["by", "date", "digest"],
      "properties": {"by": {"type": "string"}, "date": {"type": "string"}, "digest": {"type": "string"}}
    },
    "claude_version": {"type": "string"},
    "prereqs": {"type": "array", "items": {"$ref": "#/$defs/prereq"}},
    "settings_permissions": {
      "type": "object", "propertyNames": {"enum": ["single", "factory"]},
      "additionalProperties": {"$ref": "#/$defs/permissions"},
      "description": "per arm that ran, the permissions block of its runs' settings file: the arm's allow list, and its deny list followed by the isolation rules. The arm's lists also go on the command line; the file carries them because settings-file rules are documented to reach subagents, and whether workers obey them stays unverified until a paid run"},
    "unsandboxed_commands": {"type": "array", "items": {"type": "string"},
      "description": "the user's sandbox.excludedCommands entries the arms need, git among them, which therefore ran outside the sandbox: exclusion lists combine across settings files, so the run's file cannot remove them, and a deny rule would stop the arm. Every other entry gets a deny rule in the run's file. Optional; absent in documents from before it"},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "sandbox": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "autoAllowBashIfSandboxed", "allowUnsandboxedCommands", "failIfUnavailable",
        "excludedCommands", "network", "filesystem"],
      "properties": {
        "enabled": {"const": true},
        "autoAllowBashIfSandboxed": {"const": false, "description": "the permission lists keep deciding which commands run"},
        "allowUnsandboxedCommands": {"const": false, "description": "no retry outside the sandbox"},
        "failIfUnavailable": {"const": true, "description": "claude exits at startup rather than run the arm unsandboxed"},
        "excludedCommands": {"type": "array", "maxItems": 0, "description": "empty on purpose, so the user's own exclusions are not inherited"},
        "network": {
          "type": "object", "additionalProperties": false,
          "required": ["strictAllowlist", "allowLocalBinding", "allowAllUnixSockets"],
          "properties": {
            "strictAllowlist": {"const": true, "description": "no domain is allowed and no prompt opens one"},
            "allowLocalBinding": {"const": true, "description": "the components' tests bind loopback ports; localhost services stay reachable as a result"},
            "allowAllUnixSockets": {"const": false}
          }
        },
        "filesystem": {
          "type": "object", "additionalProperties": false, "required": ["allowWrite"],
          "properties": {"allowWrite": {"type": "array", "items": {"type": "string"},
            "description": "the run's temp dir, then the Go build cache when go answered"}}
        }
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false, "required": ["allow", "deny"],
      "properties": {
        "allow": {"type": "array", "items": {"type": "string"}},
        "deny": {"type": "array", "items": {"type": "string"}}
      }
    },
    "prereq": {
      "type": "object", "additionalProperties": false, "required": ["name", "ok"],
      "properties": {"name": {"type": "string"}, "ok": {"type": "boolean"}, "detail": {"type": "string"}}
    },
    "tokens": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "output", "cache_read", "cache_creation"],
      "properties": {
        "input": {"type": "integer", "minimum": 0},
        "output": {"type": "integer", "minimum": 0},
        "cache_read": {"type": "integer", "minimum": 0},
        "cache_creation": {"type": "integer", "minimum": 0}
      }
    },
    "installed": {
      "type": "object", "additionalProperties": false, "required": ["files", "belt_version"],
      "description": "what the host had installed when the run started",
      "properties": {
        "files": {"type": "object", "additionalProperties": {"type": "string"},
          "description": "sha256:<hex>, missing, or unreadable: <error>, keyed by path under the home dir: every file of the factory and loom skill dirs (evals/ aside) and each worker definition; a skill dir that is missing records under its own path with a trailing slash"},
        "belt_version": {"type": "string"}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["name", "pass"],
      "properties": {
        "name": {"enum": ["branch", "allowed_paths", "outline", "humanizer", "build_test"]},
        "pass": {"type": "boolean"},
        "detail": {"type": "string"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "branch", "checks", "deterministic_pass", "judge_score", "judge_reasons",
        "judge_attempts", "score"],
      "properties": {
        "component": {"type": "string"},
        "branch": {"type": "string"},
        "checks": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/check"}},
        "deterministic_pass": {"type": "boolean"},
        "judge_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 10,
          "description": "the judge's raw score, null when the judge did not answer"},
        "judge_reasons": {"type": "array", "items": {"type": "string"}},
        "judge_attempts": {"type": "integer", "minimum": 0, "maximum": 2,
          "description": "judge calls made; a failed first call gets one retry, and a failed retry errors the run"},
        "judge_error": {"type": "string"},
        "score": {"type": "integer", "minimum": 0, "maximum": 10,
          "description": "judge_score when every check passed, else 0"}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["arm", "tier", "run_index", "model", "effort", "budget_usd", "tokens_in", "tokens_out",
        "tokens_total", "tokens", "dollars", "judge_dollars", "wall_clock_ms", "num_turns", "stop",
        "permission_denials", "installed", "tainted", "taint", "cases", "judge_score", "judge_reasons", "pass"],
      "properties": {
        "arm": {"enum": ["single", "factory"]},
        "tier": {"type": "string"},
        "run_index": {"type": "integer", "minimum": 1},
        "model": {"type": "string"},
        "effort": {"type": "string"},
        "budget_usd": {"type": "number", "exclusiveMinimum": 0},
        "tokens_in": {"type": "integer", "minimum": 0, "description": "input + cache_read + cache_creation"},
        "tokens_out": {"type": "integer", "minimum": 0},
        "tokens_total": {"type": "integer", "minimum": 0, "description": "what the pass rule compares"},
        "tokens": {"$ref": "#/$defs/tokens"},
        "dollars": {"type": "number", "minimum": 0, "description": "the arm session's total_cost_usd, subagents included"},
        "judge_dollars": {"type": "number", "minimum": 0},
        "wall_clock_ms": {"type": "integer", "minimum": 0},
        "num_turns": {"type": "integer", "minimum": 0},
        "session_id": {"type": "string"},
        "stop": {"type": "string", "description": "the result subtype, or error when no result came back; anything but success counts as errored"},
        "error": {"type": "string", "description": "why factory-eval, claude or the judge failed, or the errors of a result with is_error set, subtype success included; any error counts as errored"},
        "permission_denials": {"type": "integer", "minimum": 0},
        "agent_report": {"description": "the session's structured final report, as it returned it"},
        "settings_file": {"type": "string", "description": "the harness settings file passed with --settings"},
        "settings_sandbox": {"$ref": "#/$defs/sandbox",
          "description": "the sandbox block of that file: Claude Code's OS sandbox around every Bash command of the session, workers included; kept here because a passing run's checkout and file are removed"},
        "installed": {"$ref": "#/$defs/installed"},
        "tainted": {"type": "boolean", "description": "the source checkout changed during the run; counts as errored"},
        "taint": {"type": "array", "items": {"type": "string"}, "description": "how the source checkout changed"},
        "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
        "judge_score": {"type": "number", "minimum": 0, "maximum": 10, "description": "mean of the case scores"},
        "judge_reasons": {"type": "array", "items": {"type": "string"}},
        "pass": {"type": "boolean"},
        "kept_dir": {"type": "string", "description": "the throwaway checkout, kept because the run failed"}
      }
    },
    "arm_stats": {
      "type": "object", "additionalProperties": false,
      "required": ["arm", "tier", "runs", "runs_errored", "runs_passed", "mean_judge_score",
        "mean_wall_clock_ms", "mean_tokens", "mean_dollars"],
      "description": "the means cover only the runs that did not error",
      "properties": {
        "arm": {"enum": ["single", "factory"]},
        "tier": {"type": "string"},
        "runs": {"type": "integer", "minimum": 1},
        "runs_errored": {"type": "integer", "minimum": 0},
        "runs_passed": {"type": "integer", "minimum": 0},
        "mean_judge_score": {"type": "number"},
        "mean_wall_clock_ms": {"type": "number"},
        "mean_tokens": {"type": "number"},
        "mean_dollars": {"type": "number"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["tier", "expected_runs", "complete", "judge_single", "judge_factory", "wall_ratio",
        "token_ratio", "judge_ok", "wall_ok", "tokens_ok", "factory_runs_passed", "pass", "reason"],
      "properties": {
        "tier": {"type": "string"},
        "expected_runs": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean", "description": "each arm recorded every expected run and none errored"},
        "judge_single": {"type": "number"},
        "judge_factory": {"type": "number"},
        "wall_ratio": {"type": "number", "description": "factory mean over single mean"},
        "token_ratio": {"type": "number", "description": "factory mean over single mean"},
        "judge_ok": {"type": "boolean"},
        "wall_ok": {"type": "boolean"},
        "tokens_ok": {"type": "boolean"},
        "factory_runs_passed": {"type": "integer", "minimum": 0},
        "pass": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["arms", "decisions", "primary_tier", "pass", "decision"],
      "properties": {
        "arms": {"type": "array", "items": {"$ref": "#/$defs/arm_stats"}},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
        "primary_tier": {"type": "string"},
        "pass": {"type": "boolean", "description": "the primary tier's decision"},
        "decision": {"type": "string", "description": "the primary tier's reason, prefixed provisional when the batch ran fewer runs per arm than the cases file asks for"}
      }
    }
  }
}
