claude [mcp] [list]
claude [mcp] [add] [--scope] [user] [alpha] [--] [{HOME}/code/bin/alpha] [mcp] [--root] [{HOME}/data/alpha]
claude [mcp] [add] [--scope] [user] [bravo] [-e] [BRAVO_PORT=7001] [-e] [BRAVO_RETRIES=3] [-e] [BRAVO_VERBOSE=True] [-e] [BRAVO_RATIO=0.5] [-e] [BRAVO_UNSET=None] [--] [/opt/bravo/bin/bravo]
claude [mcp] [add] [--scope] [user] [--transport] [http] [charlie] [https://mcp.example.com/charlie]
claude [mcp] [add] [--scope] [user] [--transport] [sse] [delta] [https://mcp.example.com/delta/sse] [--header] [X-Team: blue] [--header] [X-Retry: 2]
claude [mcp] [add-json] [--scope] [user] [echo] [{"type": "http", "url": "https://mcp.example.com/echo", "headersHelper": "{HOME}/bin/echo-headers.sh", "headers": {"X-Static": "1"}}]
claude [mcp] [add-json] [--scope] [user] [foxtrot] [{"type": "http", "url": "https://mcp.example.com/foxtrot", "headersHelper": "/opt/foxtrot/headers.sh"}]
