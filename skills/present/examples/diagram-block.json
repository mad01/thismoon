        "h": "An image without its border",
        "blocks": [
          {
            "t": "image",
            "src": "https://raw.githubusercontent.com/mad01/thismoon/main/docs/assets/logo.png",
            "alt": "The thismoon logo: a tin of three blue sardines under a wave, with a cream lid and a dark outline",
            "caption": "The repo logo as a borderless image, fetched from GitHub.",
            "frame": false
          },
          {
            "t": "p",
            "text": "An image sets frame to false to drop its border, for transparent exports and screenshots that carry their own edge."
          }
        ]
      },
      {
        "h": "Rules the renderer enforces",
        "blocks": [
          {
            "t": "list",
            "items": [
              "At most 24 boxes, 12 groups, and two levels of groups per diagram.",
              "Labels up to 32 characters, texts 60, edge labels 24; ids are plain tokens.",
              "An element never appears before what holds it, and a step's focus names only what has appeared.",
              "A weight needs flow, a pair of boxes gets one edge per direction, and a box never points at itself."
            ]
          },
          {
            "t": "callout",
            "text": "Stored pages pick up renderer changes on their next load. The layout runs in the browser, so no page needed a rerender for the spacing fix.",
            "sev": "info"
          }
        ]
      }
    ]
