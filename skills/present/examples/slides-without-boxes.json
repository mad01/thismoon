            "groups": [
              {
                "id": "prod",
                "label": "prod cluster"
              },
              {
                "id": "ns_checkout",
                "label": "checkout namespace",
                "group": "prod",
                "step": 1
              },
              {
                "id": "ns_data",
                "label": "data namespace",
                "tone": "amber",
                "group": "prod",
                "step": 4
              }
            ],
            "nodes": [
              {
                "id": "gw",
                "label": "Gateway",
                "text": "Envoy, terminates TLS",
                "group": "prod",
                "tone": "neutral"
              },
              {
                "id": "api",
                "label": "Checkout API",
                "text": "Go, validates the cart",
                "group": "ns_checkout",
                "step": 1,
                "tone": "green"
              },
              {
                "id": "pricing",
                "label": "Pricing",
                "text": "Go, quotes and discounts",
                "group": "ns_checkout",
                "step": 2,
                "tone": "green"
              },
              {
                "id": "stock",
                "label": "Stock",
                "text": "Go, reserves units",
                "group": "ns_checkout",
                "step": 3,
                "tone": "green"
              },
              {
                "id": "orders",
                "label": "Orders DB",
                "text": "Postgres, one row per order",
                "kind": "store",
                "group": "ns_data",
                "step": 4,
                "tone": "blue"
              },
              {
                "id": "events",
                "label": "Order events",
                "text": "Kafka, one topic",
                "kind": "queue",
                "group": "ns_data",
                "step": 4,
                "tone": "blue"
              },
              {
                "id": "mailer",
                "label": "Mailer",
                "text": "sends the receipt",
                "group": "ns_checkout",
                "step": 5,
                "tone": "green"
              }
            ],
            "edges": [
              {
                "from": "gw",
                "to": "api",
                "label": "route",
                "flow": true,
                "weight": 300,
                "step": 1
              },
              {
                "from": "api",
                "to": "pricing",
                "label": "quote",
                "step": 2
              },
              {
                "from": "pricing",
                "to": "api",
                "label": "price",
                "step": 2
              },
              {
