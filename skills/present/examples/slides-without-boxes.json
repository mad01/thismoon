                "to": "stock",
                "label": "reserve",
                "step": 3
              },
              {
                "from": "api",
                "to": "orders",
                "label": "insert",
                "step": 4
              },
              {
                "from": "api",
                "to": "events",
                "label": "order placed",
                "flow": true,
                "weight": 300,
                "step": 4
              },
              {
                "from": "events",
                "to": "mailer",
                "label": "consume",
                "flow": true,
                "weight": 300,
                "step": 5
              }
            ],
            "steps": [
              {
                "caption": "The gateway routes the request into the checkout namespace.",
                "focus": [
                  "api"
                ]
              },
              {
                "caption": "The API asks pricing for a quote and gets the price back.",
                "focus": [
                  "pricing"
                ]
              },
              {
                "caption": "Stock reserves the units.",
                "focus": [
                  "stock"
                ]
              },
              {
                "caption": "The order is written and an event goes on the topic.",
                "focus": [
                  "ns_data"
                ]
              },
              {
                "caption": "The mailer consumes the event and sends the receipt."
              }
            ]
          }
        ]
      },
      {
        "h": "Rules the deck follows",
        "blocks": [
          {
            "t": "list",
            "items": [
              "Never set frame to true on a chart in a deck.",
              "Keep panel blocks in the brief.",
              "Use tone for the accent of a divider or a slide, never as a fill.",
              "One stat or one quote alone on a slide, two or three stats in a columns row for figures."
            ]
          },
          {
            "t": "callout",
            "text": "The change is CSS only. Every stored deck shows the new look at its next load, with no rerender.",
            "sev": "info"
          }
        ]
      }
    ]
